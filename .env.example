# URL pública del servidor (sin / al final). En local: http://localhost:8000
BASE_URL=https://correo-mcp.konto.org.in

# Cliente OAuth de Google (tipo "Aplicación web"). URIs de redirección autorizadas:
#   {BASE_URL}/auth/callback    → para que entres cuando Claude se conecta
#   {BASE_URL}/google/callback  → para conectar cuentas de Gmail
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

DATABASE_URL=postgresql://inboxbridge:inboxbridge@localhost:5433/inboxbridge

# Correos de Google que pueden entrar, separados por coma.
OWNER_EMAILS=tu-correo@gmail.com

# De aquí salen todas las llaves (tokens, sesión, JWT). Genérala con: openssl rand -base64 48
# Si la cambias, hay que reconectar las cuentas y volver a conectar Claude.
MASTER_KEY=

ZONA_HORARIA=America/Bogota

# Canal de avisos (opcional). Sin URL, la herramienta enviar_aviso no existe.
# El webhook recibe {"mensaje": "..."} con la cabecera X-Inboxbridge-Token, y quien lo recibe
# (p. ej. un workflow de n8n) decide a quién le llega. Ese destinatario debe ser fijo.
AVISOS_WEBHOOK_URL=
AVISOS_WEBHOOK_TOKEN=
AVISOS_MAX_DIARIOS=12

# API para n8n (opcional): GET /api/estado (alarma si la rutina no corre) y POST /api/comandos
# (comandos por WhatsApp). Se envía como «Authorization: Bearer <token>». Mínimo 32 caracteres:
# openssl rand -hex 32
API_TOKEN=

# Solo en local: deja /mcp sin OAuth. Nunca en el VPS (el servidor no arranca con https).
AUTH_ENABLED=true
